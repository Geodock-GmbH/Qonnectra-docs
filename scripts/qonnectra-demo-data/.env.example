# Credentials for fetch_geodock_export.py - the account the export is pulled
# with on app.geodock.de. Copy this file to .env next to it and fill it in:
#
#   cp scripts/qonnectra-demo-data/.env.example scripts/qonnectra-demo-data/.env
#
# .env is gitignored and must never be committed. These are the credentials of
# a real installation, not of the local instance in local-app/.
GEODOCK_USERNAME=
GEODOCK_PASSWORD=
